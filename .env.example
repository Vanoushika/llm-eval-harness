# Copy to .env and fill in as needed. No secrets are required to run the
# harness — the offline provider and the fake judge work with nothing
# configured.
# Database: SQLite file by default; point at PostgreSQL in production.
DATABASE_URL=sqlite:///./evalharness.db
# Hosted model provider (day 2): set to run suites against a real model.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# LLM-as-judge model (day 2): used when a scorer sets judge: openai.
# OPENAI_JUDGE_MODEL=gpt-4o-mini
